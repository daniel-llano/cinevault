{
  "ConnectionStrings": {
    "CineVault": "Data Source=cinevault.db"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Catalog": {
    "ImportCsv": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "CineVault",
    "Audience": "CineVault",
    "AccessTokenMinutes": 120
  },
  "Cors": {
    "Origins": []
  },
  "Bootstrap": {
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "EnableApiDocs": false,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
